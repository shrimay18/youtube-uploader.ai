# Copy this file to `.env` and fill in your own values. `.env` is gitignored and
# loaded into the environment automatically at startup — it is the single source
# of truth for all secrets. NEVER commit real keys.

# ---- LLM providers (local + hosted) -----------------------------------------
GEMINI_API_KEY=your-gemini-key-here          # https://aistudio.google.com/apikey (free)
GROQ_API_KEY=your-groq-key-here              # https://console.groq.com/keys (free fallback)
# ANTHROPIC_API_KEY=your-anthropic-key       # only if settings.yaml engine: claude

# ---- YouTube Data API (research/READ only; comma-separated keys are rotated) --
YOUTUBE_API_KEY=your-youtube-data-api-key    # Google Cloud -> Credentials -> API key

# ---- Supabase (hosted auth + telemetry) -------------------------------------
# url + anon key are PUBLIC by design; the service key is SECRET (backend only).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key   # backend only — full DB access, never ship
TM_ADMIN_EMAILS=you@example.com,teammate@example.com  # admin-dashboard whitelist (PII)

# ---- Production / SaaS only (see docs/deploy-oracle.md) ----------------------
# TM_MASTER_KEY=generate-once-and-keep-safe   # Fernet master key for encrypting user keys
# GOOGLE_CLIENT_ID=your-app-oauth-client-id   # web YouTube OAuth (P2)
# GOOGLE_CLIENT_SECRET=your-app-oauth-secret
# REDIS_URL=redis://localhost:6379            # enables the RQ job queue (P3)
# TM_TRANSCRIBER=local                        # local | deepgram | openai
# DEEPGRAM_API_KEY=...                         # if TM_TRANSCRIBER=deepgram
# TM_ALLOWED_ORIGIN=https://your-app.vercel.app  # CORS allow-list for the frontend
# TM_APP_URL=https://api.your-domain.com
